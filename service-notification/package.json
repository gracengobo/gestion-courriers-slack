{
  "name": "service-notification",
  "version": "1.0.0",
  "private": true,
  "description": "Service de notification Slack : messages, rappels et escalades des courriers",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx src/test-notification.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@slack/types": "^2.9.0",
    "@slack/web-api": "^7.8.0",
    "amqplib": "^2.2.1",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
