generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Courrier {
  id             String   @id @default(uuid())
  numero         String   @unique
  objet          String
  expediteur     String
  destinataire   String
  contenu        String?
  pieceJointeUrl String?
  statut         String   @default("RECU")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("courriers")
}

model CompteurCourrier {
  annee         Int @id
  dernierNumero Int

  @@map("compteurs_courrier")
}

model JournalAudit {
  id         String   @id @default(uuid())
  action     String
  courrierId String
  numero     String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([courrierId, createdAt])
  @@index([numero, createdAt])
  @@map("journal_audit")
}
