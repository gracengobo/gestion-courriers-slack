# Base de donnees (ia_db, depuis la machine)
DATABASE_URL=postgresql://ia:ia_dev@localhost:5435/ia_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=courrier.events

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=scans

# gRPC (adresse du Service IA)
GRPC_IA_URL=localhost:50053

# IA (fournisseur : groq ou gemini)
IA_FOURNISSEUR=groq
IA_API_KEY=
# Optionnel. Groq : openai/gpt-oss-120b ; Gemini : gemini-flash-latest
IA_MODELE=
# Optionnel. Adresse de l'API compatible OpenAI pour Groq
IA_BASE_URL=https://api.groq.com/openai/v1