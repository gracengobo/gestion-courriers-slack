# Base de données (Exemple pour le Service Courrier)
DATABASE_URL=postgresql://courrier:courrier_dev@localhost:5433/courrier_db
DATABASE_URL_WORKFLOW=postgresql://workflow:workflow_dev@localhost:5434/workflow_db
DATABASE_URL_IA=postgresql://ia:ia_dev@localhost:5435/ia_db
DATABASE_URL_NOTIFICATION=postgresql://notification:notification_dev@localhost:5436/notification_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=courrier.events

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=scans

# Adresses gRPC (utilisees par la passerelle)
GRPC_COURRIER_URL=localhost:50051
GRPC_WORKFLOW_URL=localhost:50052
GRPC_IA_URL=localhost:50053

# Slack (passerelle et Service Notification)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# IA (Service IA)
IA_FOURNISSEUR=gemini
IA_API_KEY=...