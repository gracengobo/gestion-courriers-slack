DATABASE_URL="postgresql://notification:notification_dev@localhost:5436/notification_db?schema=public"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="courrier.events"

# Jeton du bot Slack utilisé par le Service Notification (chat:write, im:write).
SLACK_BOT_TOKEN="xoxb-..."

# Heure du contrôle quotidien des rappels (UTC) et fuseau utilisé par node-cron.
RAPPELS_CRON="0 8 * * *"
RAPPELS_FUSEAU="UTC"

# Dossier des traductions partagées. Par défaut : <depot>/commun/i18n.
# I18N_DIR="/chemin/vers/commun/i18n"
